# Backend Vercel environment template
# Copy these values into the Vercel project settings for the backend deployment.

NODE_ENV=production
PORT=3001
API_PREFIX=api/v1

# MongoDB
# Use either DATABASE_URL or MONGODB_URI.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority&appName=<appName>
MONGODB_URI=

# CORS / frontend origin
FRONTEND_URL=https://glovia.com.np
CORS_ORIGIN=https://glovia.com.np,https://www.glovia.com.np

# Auth
JWT_SECRET=<replace-with-secret>
JWT_REFRESH_SECRET=<replace-with-secret>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Optional services
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

EMAIL_PROVIDER=smtp
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Glovia Marketplace
SMTP_FROM_EMAIL=
